{
  "name": "pi-memory-vault",
  "version": "0.1.1",
  "description": "SQLite-backed long-term Markdown memory for Pi",
  "author": "Soma Holiday <soma@somaholiday.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/somaholiday/memory.git",
    "directory": "packages/pi-memory"
  },
  "homepage": "https://github.com/somaholiday/memory#readme",
  "bugs": "https://github.com/somaholiday/memory/issues",
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "publishConfig": { "access": "public" },
  "keywords": ["pi-package", "memory", "markdown", "sqlite"],
  "files": ["dist", "README.md", "LICENSE"],
  "pi": {
    "extensions": ["./dist/index.js"]
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "yaml": "^2.9.0"
  },
  "optionalDependencies": {
    "sqlite-vec": "^0.1.9"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --platform node --out-dir dist --external better-sqlite3 --external sqlite-vec --external @earendil-works/pi-ai --external @earendil-works/pi-coding-agent --external @earendil-works/pi-tui --external typebox",
    "prepack": "npm run build"
  }
}
